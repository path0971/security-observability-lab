# 이 파일을 terraform.tfvars로 복사한 뒤 본인 값으로 바꾸세요.
aws_profile    = "<AWS_PROFILE>"
aws_account_id = "<AWS_ACCOUNT_ID>"

# network/eks 스택 적용 후 확인한 값
vpc_id                = "<VPC_ID>"
eks_security_group_id = "<EKS_CLUSTER_SECURITY_GROUP_ID>"
db_subnet_ids         = ["<DB_SUBNET_A_ID>", "<DB_SUBNET_C_ID>"]
